# MediCare API — restart `npm run dev` in the server folder after changes.

PORT=5000

MYSQL_USER=kut
# MySQL password for user `multicare` (quoted because of @)
MYSQL_PASSWORD="Kut@2022"

DB_HOST=127.0.0.1
MYSQL_DATABASE=hms_db

JWT_SECRET=hms-local-access-token-secret-min-32-chars-long
JWT_REFRESH_SECRET=hms-local-refresh-token-secret-min-32-chars

JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=http://192.168.0.105:5173

# Email (SMTP) — fill in to enable password-reset notifications
# For Gmail use an App Password (not your main password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Multicare Hospital <noreply@multicare.co.ke>
